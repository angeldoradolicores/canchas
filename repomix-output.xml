              <div className="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-2">
                {Array.from(new Set([...MODALITIES, ...types])).map(m => {
                  const active = types.includes(m);
                  return (
                    <button
                      key={m}
