<file path="app/(main)/favorites/page.tsx">
'use client';
import { useEffect, useState } from 'react';
import { createClient } from '@/lib/supabase/client';
import { useAuth } from '@/lib/auth-context';
import { Loader2, Heart, MapPin, Star, ArrowRight } from 'lucide-react';
import Link from 'next/link';
import { useRouter } from 'next/navigation';
interface FavoritePitch {
  id: string;
  pitch_id: string;
  pitches: {
    id: string;
    name: string;
    zone: string;
    price_per_hour: number;
    type: string;
    surface: string;
    image_url: string | null;
    media_urls: string[] | null;
    rating: number | null;
  };
}
export default function FavoritesPage() {
  const { user } = useAuth();
  const router = useRouter();
  const supabase = createClient();
  const [favorites, setFavorites] = useState<FavoritePitch[]>([]);
  const [loading, setLoading] = useState(true);
  useEffect(() => {
    if (!user) {
      setLoading(false);
      return;
    }
    const fetchFavorites = async () => {
      const { data: favs, error: favError } = await supabase
        .from('pitch_favorites')
        .select('id, pitch_id')
        .eq('user_id', user.id)
        .order('created_at', { ascending: false });
      if (favError || !favs || favs.length === 0) {
        setFavorites([]);
        setLoading(false);
        return;
      }
      const pitchIds = favs.map(f => f.pitch_id);
      const { data: pitchesData } = await supabase
        .from('pitches')
        .select('id, name, zone, price_per_hour, type, surface, image_url, media_urls, rating')
        .in('id', pitchIds);
      const pitchesMap = new Map((pitchesData || []).map(p => [p.id, p]));
      const combined = favs.map(f => ({
        id: f.id,
        pitch_id: f.pitch_id,
        pitches: pitchesMap.get(f.pitch_id) || null
      })).filter(f => f.pitches !== null);
      setFavorites(combined as any);
      setLoading(false);
    };
    fetchFavorites();
  }, [user, supabase]);
  const removeFavorite = async (favoriteId: string) => {
    await supabase.from('pitch_favorites').delete().eq('id', favoriteId);
    setFavorites((prev) => prev.filter((f) => f.id !== favoriteId));
  };
  if (!user) {
    return (
      <div className="page-content flex flex-col items-center justify-center min-h-[60vh] text-center gap-4">
        <Heart size={48} className="text-muted-foreground opacity-40" />
        <h2 className="text-2xl font-bold">Inicia sesión</h2>
        <p className="text-muted-foreground text-sm">Debes iniciar sesión para ver tus canchas favoritas.</p>
      </div>
    );
  }
  return (
    <section className="page-content fade-in">
      <div className="mb-8">
        <p className="eyebrow accent-label text-xs font-bold text-primary uppercase">MIS CANCHAS</p>
        <h1 className="text-2xl sm:text-3xl font-black text-foreground mt-1">Favoritos</h1>
        <p className="text-sm text-muted-foreground mt-1">
          {favorites.length} cancha{favorites.length !== 1 ? 's' : ''} guardada{favorites.length !== 1 ? 's' : ''}
        </p>
      </div>
      {loading ? (
        <div className="flex justify-center py-16">
          <Loader2 size={36} className="animate-spin text-primary" />
        </div>
      ) : favorites.length === 0 ? (
        <div className="flex flex-col items-center justify-center py-20 text-center">
          <div className="w-20 h-20 rounded-full bg-red-50 border-2 border-red-100 flex items-center justify-center mb-5">
            <Heart size={36} className="text-red-300" />
          </div>
          <h3 className="text-lg font-bold mb-2">Aún no tienes favoritos</h3>
          <p className="text-sm text-muted-foreground mb-6 max-w-xs">
            Cuando encuentres una cancha que te guste, tócale el corazón ❤️ para guardarla aquí.
          </p>
          <Link href="/" className="btn-primary text-sm">
            Explorar canchas
          </Link>
        </div>
      ) : (
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {favorites.map((fav) => {
            const pitch = fav.pitches;
            if (!pitch) return null;
            const imageUrl = (pitch.media_urls && pitch.media_urls.length > 0)
              ? pitch.media_urls[0]
              : pitch.image_url;
            const isYoutube = imageUrl && (imageUrl.includes('youtube.com') || imageUrl.includes('youtu.be'));
            return (
              <div key={fav.id} className="group relative bg-card border border-border rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-shadow">
                {}
                <div className="relative h-44 bg-secondary overflow-hidden">
                  {imageUrl && !isYoutube ? (
                    <img
                      src={imageUrl}
                      alt={pitch.name}
                      className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  ) : (
                    <div className="w-full h-full bg-gradient-to-br from-primary/20 to-primary/5 flex items-center justify-center">
                      <span className="text-4xl">⚽</span>
                    </div>
                  )}
                  {}
                  <button
                    type="button"
                    onClick={() => removeFavorite(fav.id)}
                    className="absolute top-3 right-3 w-9 h-9 rounded-full bg-white/90 text-red-500 flex items-center justify-center shadow-md hover:scale-110 transition-transform"
                    title="Quitar de favoritos"
                  >
                    <Heart size={16} className="fill-current" />
                  </button>
                  {}
                  <div className="absolute bottom-3 left-3 bg-black/70 text-white text-xs font-bold px-2.5 py-1 rounded-full backdrop-blur-sm">
                    ${Number(pitch.price_per_hour || 0).toLocaleString('es-CO')}/h
                  </div>
                </div>
                {}
                <div className="p-4">
                  <h3 className="font-bold text-foreground mb-1 truncate">{pitch.name}</h3>
                  <p className="text-xs text-muted-foreground flex items-center gap-1 mb-3">
                    <MapPin size={11} /> {pitch.zone || 'Pasto, Nariño'}
                  </p>
                  <div className="flex items-center justify-between">
                    <div className="flex gap-2">
                      {pitch.type && (
                        <span className="text-[10px] bg-secondary border border-border px-2 py-0.5 rounded-full font-medium">
                          {pitch.type}
                        </span>
                      )}
                      {pitch.surface && (
                        <span className="text-[10px] bg-secondary border border-border px-2 py-0.5 rounded-full font-medium">
                          {pitch.surface}
                        </span>
                      )}
                    </div>
                    {pitch.rating && (
                      <span className="flex items-center gap-1 text-[11px] font-bold text-amber-500">
                        <Star size={11} className="fill-current" /> {pitch.rating}
                      </span>
                    )}
                  </div>
                  <Link
                    href={`/cancha/${pitch.id}`}
                    className="mt-4 w-full flex items-center justify-center gap-2 py-2.5 rounded-xl bg-primary text-white text-xs font-bold hover:bg-primary/90 transition-colors"
                  >
                    Ver cancha <ArrowRight size={13} />
                  </Link>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </section>
  );
}
