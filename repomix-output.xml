'use client';
import { useEffect, useState } from 'react';
import { createClient } from '@/lib/supabase/client';
import { Loader2, MapPin, Star, User, Trophy, Calendar, ArrowLeft } from 'lucide-react';
import Link from 'next/link';
import { useParams, useRouter } from 'next/navigation';
interface PublicProfile {
  id: string;
  full_name: string | null;
  avatar_url: string | null;
  phone: string | null;
  position: string | null;
  preferred_foot: string | null;
  skill_level: string | null;
  looking_for_team: boolean | null;
  created_at: string;
}
const skillLabels: Record<string, string> = {
  beginner: 'Principiante',
  intermediate: 'Intermedio',
  advanced: 'Avanzado',
  pro: 'Profesional',
};
const positionLabels: Record<string, string> = {
  goalkeeper: '🧤 Portero',
  defender: '🛡️ Defensa',
  midfielder: '⚙️ Mediocampista',
  forward: '⚡ Delantero',
};
export default function PublicProfilePage() {
  const params = useParams();
  const router = useRouter();
  const id = params?.id as string;
  const supabase = createClient();
  const [profile, setProfile] = useState<PublicProfile | null>(null);
  const [reviews, setReviews] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [notFound, setNotFound] = useState(false);
  useEffect(() => {
    if (!id) return;
    const fetchProfile = async () => {
      const { data: profileData, error: profileError } = await supabase
        .from('profiles')
        .select('id, full_name, avatar_url, phone, position, preferred_foot, skill_level, looking_for_team, created_at')
        .eq('id', id)
        .single();
      if (profileError || !profileData) {
        setNotFound(true);
        setLoading(false);
        return;
      }
      setProfile(profileData);
      const { data: reviewsData } = await supabase
        .from('pitch_reviews')
        .select(`
          id, rating, comment, created_at,
          pitches (id, name, zone)
        `)
        .eq('user_id', id)
        .order('created_at', { ascending: false })
        .limit(10);
      if (reviewsData) setReviews(reviewsData);
      setLoading(false);
    };
    fetchProfile();
  }, [id, supabase]);
  if (loading) {
    return (
      <div className="flex items-center justify-center min-h-[60vh]">
        <Loader2 size={36} className="animate-spin text-primary" />
      </div>
    );
  }
  if (notFound || !profile) {
    return (
      <div className="page-content flex flex-col items-center justify-center min-h-[60vh] text-center gap-4">
        <User size={48} className="text-muted-foreground" />
        <h2 className="text-2xl font-bold">Perfil no encontrado</h2>
        <p className="text-muted-foreground">Este usuario no existe o su perfil es privado.</p>
        <button onClick={() => router.back()} className="btn-primary text-sm">
          Volver
        </button>
      </div>
    );
  }
  const initials = profile.full_name
    ? profile.full_name.split(' ').map((n) => n[0]).join('').slice(0, 2).toUpperCase()
    : 'U';
  const memberSince = new Date(profile.created_at).toLocaleDateString('es-CO', {
    year: 'numeric',
    month: 'long',
  });
  return (
    <section className="page-content fade-in max-w-3xl mx-auto">
      <button
        type="button"
        onClick={() => router.back()}
        className="back-link flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground mb-6"
      >
        <ArrowLeft size={16} /> Volver
      </button>
      {}
      <div className="relative bg-gradient-to-br from-primary/20 via-primary/10 to-transparent rounded-3xl border border-border p-8 mb-8 overflow-hidden">
        <div className="absolute inset-0 opacity-5 pointer-events-none">
          <div className="absolute -top-10 -right-10 w-64 h-64 rounded-full bg-primary" />
        </div>
        <div className="flex flex-col sm:flex-row items-center sm:items-start gap-6 relative z-10">
          {}
          <div className="w-24 h-24 rounded-full overflow-hidden border-4 border-primary/30 shadow-xl bg-primary/20 flex items-center justify-center flex-shrink-0">
            {profile.avatar_url ? (
              <img src={profile.avatar_url} alt={profile.full_name || ''} className="w-full h-full object-cover" />
            ) : (
              <span className="text-primary font-black text-3xl">{initials}</span>
            )}
          </div>
          {/* Info */}
          <div className="flex-1 text-center sm:text-left">
            <h1 className="text-2xl sm:text-3xl font-black text-foreground mb-1">
              {profile.full_name || 'Jugador'}
            </h1>
            <p className="text-sm text-muted-foreground flex items-center justify-center sm:justify-start gap-1.5 mb-3">
              <Calendar size={13} /> Miembro desde {memberSince}
            </p>
            <div className="flex flex-wrap gap-2 justify-center sm:justify-start">
              {profile.position && (
                <span className="px-3 py-1 bg-primary/10 text-primary text-xs font-bold rounded-full border border-primary/20">
                  {positionLabels[profile.position] || profile.position}
                </span>
              )}
              {profile.skill_level && (
                <span className="px-3 py-1 bg-secondary text-foreground text-xs font-bold rounded-full border border-border">
                  🎮 {skillLabels[profile.skill_level] || profile.skill_level}
                </span>
              )}
              {profile.preferred_foot && (
                <span className="px-3 py-1 bg-secondary text-foreground text-xs font-bold rounded-full border border-border">
                  👟 {profile.preferred_foot === 'left' ? 'Zurdo' : profile.preferred_foot === 'right' ? 'Diestro' : 'Ambidiestro'}
                </span>
              )}
              {profile.looking_for_team && (
                <span className="px-3 py-1 bg-green-500/10 text-green-600 text-xs font-bold rounded-full border border-green-500/20 flex items-center gap-1">
                  <span className="w-1.5 h-1.5 rounded-full bg-green-500 inline-block animate-pulse" />
                  Buscando equipo
                </span>
              )}
            </div>
          </div>
        </div>
      </div>
      {}
      <div className="bg-card border border-border rounded-2xl p-6">
