                      {new Date(review.created_at).toLocaleDateString('es-CO')}
                    </p>
                  </div>
                </div>
                <p className="text-sm text-muted-foreground leading-relaxed">{review.comment}</p>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>
  );
}
