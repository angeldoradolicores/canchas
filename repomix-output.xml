                {/* Filtros / Pestañas de Categorías */}
                <div className="flex bg-secondary/50 p-1.5 rounded-xl border border-border gap-1">
                  {([
                    { key: 'manana', icon: '', title: 'Mañana' },
                    { key: 'tarde', icon: '', title: 'Tarde' },
