<file path="components/explore/CustomMonthCalendar.tsx">
'use client';
import { useState } from 'react';
import { ChevronLeft, ChevronRight } from 'lucide-react';
const MONTH_NAMES = [
  'ENERO', 'FEBRERO', 'MARZO', 'ABRIL', 'MAYO', 'JUNIO',
  'JULIO', 'AGOSTO', 'SEPTIEMBRE', 'OCTUBRE', 'NOVIEMBRE', 'DICIEMBRE'
];
const WEEKDAYS = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];
interface CustomMonthCalendarProps {
  selectedDate: string;
  onSelectDate: (dateStr: string) => void;
  minDate?: string | null;
}
export function CustomMonthCalendar({ selectedDate, onSelectDate, minDate }: CustomMonthCalendarProps) {
  const todayObj = new Date();
  const initialYear = selectedDate ? parseInt(selectedDate.split('-')[0]) : todayObj.getFullYear();
  const initialMonth = selectedDate ? parseInt(selectedDate.split('-')[1]) - 1 : todayObj.getMonth();
  const [currentYear, setCurrentYear] = useState(initialYear);
  const [currentMonth, setCurrentMonth] = useState(initialMonth);
  const minDateObj = minDate ? new Date(minDate + 'T00:00:00') : null;
  if (minDateObj) {
    minDateObj.setHours(0, 0, 0, 0);
  }
  const handlePrevMonth = () => {
    if (currentMonth === 0) {
      setCurrentMonth(11);
      setCurrentYear(y => y - 1);
    } else {
      setCurrentMonth(m => m - 1);
    }
  };
  const handleNextMonth = () => {
    if (currentMonth === 11) {
      setCurrentMonth(0);
      setCurrentYear(y => y + 1);
    } else {
      setCurrentMonth(m => m + 1);
    }
  };
  const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
  const firstWeekday = new Date(currentYear, currentMonth, 1).getDay();
  const cells: Array<{ type: 'blank' | 'day'; dayNumber?: number; dateStr?: string; isDisabled?: boolean; isToday?: boolean; isSelected?: boolean }> = [];
  for (let i = 0; i < firstWeekday; i++) {
    cells.push({ type: 'blank' });
  }
  for (let day = 1; day <= daysInMonth; day++) {
    const monthStr = (currentMonth + 1).toString().padStart(2, '0');
    const dayStr = day.toString().padStart(2, '0');
    const dateStr = `${currentYear}-${monthStr}-${dayStr}`;
    const cellDate = new Date(currentYear, currentMonth, day);
    cellDate.setHours(0, 0, 0, 0);
    const isToday = cellDate.getTime() === new Date(todayObj.getFullYear(), todayObj.getMonth(), todayObj.getDate()).getTime();
    const isDisabled = minDateObj ? cellDate.getTime() < minDateObj.getTime() : false;
    const isSelected = selectedDate === dateStr;
    cells.push({
      type: 'day',
      dayNumber: day,
      dateStr,
      isDisabled,
      isToday,
      isSelected,
    });
  }
  while (cells.length < 42) {
    cells.push({ type: 'blank' });
  }
  return (
    <div className="w-full max-w-[340px] mx-auto font-sans bg-white rounded-2xl overflow-hidden shadow-lg border border-border">
      {}
      <div className="bg-primary text-white py-3.5 px-4 flex items-center justify-between">
        <button
          type="button"
          onClick={handlePrevMonth}
          className="w-8 h-8 rounded-full flex items-center justify-center hover:bg-white/20 transition-colors text-white"
          aria-label="Mes anterior"
        >
          <ChevronLeft size={20} />
        </button>
        <h3 className="font-bold text-base tracking-wide uppercase">
          {MONTH_NAMES[currentMonth]} {currentYear}
        </h3>
        <button
          type="button"
          onClick={handleNextMonth}
          className="w-8 h-8 rounded-full flex items-center justify-center hover:bg-white/20 transition-colors text-white"
          aria-label="Mes siguiente"
        >
          <ChevronRight size={20} />
        </button>
      </div>
      {}
      <div className="grid grid-cols-7 bg-secondary/60 text-center text-[11px] font-bold text-muted-foreground uppercase border-b border-border py-2">
        {WEEKDAYS.map((wd) => (
          <div key={wd}>{wd}</div>
        ))}
      </div>
      {}
      <div className="grid grid-cols-7 p-2 gap-1 bg-white">
        {cells.map((cell, idx) => {
          if (cell.type === 'blank') {
            return <div key={`blank-${idx}`} className="h-9 rounded-lg bg-secondary/20" />;
          }
          if (cell.isDisabled) {
            return (
              <div
                key={cell.dateStr}
                className="h-9 flex items-center justify-center text-xs text-muted-foreground/40 bg-secondary/10 rounded-lg cursor-not-allowed select-none line-through"
              >
                {cell.dayNumber}
              </div>
            );
          }
          return (
            <button
              key={cell.dateStr}
              type="button"
              onClick={() => cell.dateStr && onSelectDate(cell.dateStr)}
              className={`h-9 rounded-xl text-xs font-bold transition-all flex items-center justify-center ${cell.isSelected
                  ? 'bg-primary text-white shadow-md scale-105 ring-2 ring-primary/30'
                  : cell.isToday
                    ? 'bg-emerald-100 text-primary border border-primary/40'
                    : 'hover:bg-primary/10 hover:text-primary text-foreground'
                }`}
            >
              {cell.dayNumber}
            </button>
          );
        })}
      </div>
    </div>
  );
}
</file>

<file path="components/explore/DiscoverRail.tsx">
'use client';
import { useState, useEffect } from 'react';
import { ArrowRight, Clock3, Grid2X2, Heart, MapPin, Users } from 'lucide-react';
import { Button } from '@/components/ui/button';
import { Pitch } from '@/lib/types';
import { createClient } from '@/lib/supabase/client';
import { useAuth } from '@/lib/auth-context';
function DiscoverCardItem({
  pitch,
  onOpen,
  onBook,
}: {
  pitch: Pitch;
  onOpen: (p: Pitch) => void;
  onBook: (p: Pitch) => void;
}) {
  const { user } = useAuth();
  const supabase = createClient();
  const [isFav, setIsFav] = useState(false);
  const [loadingFav, setLoadingFav] = useState(false);
  useEffect(() => {
    if (!user) return;
    let cancelled = false;
    const fetchFav = async () => {
      const { data } = await supabase
        .from('pitch_favorites')
        .select('id')
        .eq('pitch_id', pitch.id)
        .eq('user_id', user.id)
        .maybeSingle();
      if (!cancelled && data) setIsFav(true);
    };
    fetchFav();
    return () => { cancelled = true; };
  }, [user, pitch.id]);
  const toggleFav = async (e: React.MouseEvent) => {
    e.preventDefault();
    e.stopPropagation();
    if (!user) {
      alert('Debes iniciar sesión para agregar a favoritos');
      return;
    }
    setLoadingFav(true);
    try {
      if (isFav) {
        const { error } = await supabase
          .from('pitch_favorites')
          .delete()
          .eq('pitch_id', pitch.id)
          .eq('user_id', user.id);
        if (!error) setIsFav(false);
        else alert('Error al quitar favorito: ' + error.message);
      } else {
        const { error } = await supabase
          .from('pitch_favorites')
          .insert({ pitch_id: pitch.id, user_id: user.id });
        if (!error) setIsFav(true);
        else alert('Error al agregar favorito: ' + error.message);
      }
    } finally {
      setLoadingFav(false);
    }
  };
  return (
    <article className="discover-card" style={{ position: 'relative' }}>
      {}
      <button
        type="button"
        onClick={toggleFav}
        disabled={loadingFav}
        style={{
          position: 'absolute',
          top: '10px',
          right: '10px',
          zIndex: 30,
          background: isFav ? '#ef4444' : 'rgba(255,255,255,0.92)',
          color: isFav ? 'white' : '#374151',
          border: 'none',
          borderRadius: '50%',
          width: '36px',
          height: '36px',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          cursor: 'pointer',
          boxShadow: '0 2px 8px rgba(0,0,0,0.15)',
          transition: 'all 0.2s',
        }}
        aria-label={isFav ? 'Quitar de favoritos' : 'Agregar a favoritos'}
      >
        <Heart size={16} className={isFav ? 'fill-current' : ''} />
      </button>
      {/* Zona clickable de la tarjeta */}
      <div
        className="discover-open"
        onClick={() => onOpen(pitch)}
        style={{ cursor: 'pointer' }}
        role="button"
        tabIndex={0}
        onKeyDown={(e) => e.key === 'Enter' && onOpen(pitch)}
      >
        <div className="discover-image overflow-hidden relative">
          {(pitch as any).image_url || pitch.image ? (
            <img
              src={(pitch as any).image_url || pitch.image}
              alt={pitch.name}
              className="absolute inset-0 w-full h-full object-cover"
            />
          ) : (
            <div className={`absolute inset-0 ${(pitch as any).tone || 'field-emerald'}`} />
          )}
          <span className="discover-tag relative z-10">{pitch.type}</span>
        </div>
        <div className="discover-card-copy">
          <div className="discover-title-row">
            <strong>{pitch.name}</strong>
            <span>
              ★ {(pitch as any).rating || '4.8'}{' '}
              <small>({(pitch as any).reviews || 0})</small>
            </span>
          </div>
          <p>
            <MapPin size={14} /> {(pitch as any).distance || ''} · {(pitch as any).zone || 'Pasto'}
          </p>
          <div className="discover-meta">
            <span>
              <Users size={14} /> {(pitch as any).size || '5v5'}
            </span>
            <span>
              <Grid2X2 size={14} /> {pitch.surface || 'Sintética'}
            </span>
            <span className={(pitch as any).open ? 'available' : 'unavailable'}>
              <Clock3 size={14} />{' '}
              {(pitch as any).open ? 'Disponible hoy' : 'Agotada hoy'}
            </span>
          </div>
          <p className="discover-amenity">{(pitch as any).amenity || ''}</p>
          <div className="discover-price-row">
            <small>
              <b>${Number(pitch.price_per_hour || (pitch as any).price || 0).toLocaleString('es-CO')}</b> / hora
            </small>
          </div>
        </div>
      </div>
      <div className="discover-actions">
        <button type="button" onClick={() => onOpen(pitch)}>
          Ver cancha
        </button>
        <Button size="sm" onClick={() => onBook(pitch)}>
          Reservar <ArrowRight data-icon="inline-end" />
        </Button>
      </div>
    </article>
  );
}
interface DiscoverRailProps {
  title: string;
  subtitle: string;
  items: Pitch[];
  onOpen: (pitch: Pitch) => void;
  onBook: (pitch: Pitch) => void;
}
export function DiscoverRail({
  title,
  subtitle,
  items,
  onOpen,
  onBook,
}: DiscoverRailProps) {
  return (
    <section className="discover-section">
      <div className="discover-heading">
        <div>
          <h2>{title}</h2>
          <p>{subtitle}</p>
        </div>
        <button type="button">
          Ver todos <ArrowRight size={14} />
        </button>
      </div>
      <div className="discover-grid">
        {items.map((pitch) => (
          <DiscoverCardItem
            key={pitch.id}
            pitch={pitch}
            onOpen={onOpen}
            onBook={onBook}
          />
        ))}
      </div>
    </section>
  );
}
