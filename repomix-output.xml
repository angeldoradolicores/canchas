          <SectionGroup
            title="En Revisión"
            items={pending}
            icon={<AlertCircle size={16} className="text-amber-500" />}
          />
          <SectionGroup
            title="Canceladas"
            items={cancelled}
            icon={<XCircle size={16} className="text-red-500" />}
          />
        </div>
