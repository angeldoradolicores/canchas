{
    "ignore": {
        "customPatterns": [
            "app/globals.css",
            "**/prueba.tsx",
            "*.css",
            "*.svg",
            "*.png",
            "*.jpg",
            "*.json",
            "package-lock.json",
            "pnpm-lock.yaml",
