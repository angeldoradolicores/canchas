    {
      "parameters": {
        "jsCode": "const company = $('Get Company Details').item.json;\nconst items = $input.all();\nconst pitches = items.map(it => it.json);\n\nconst baseUrl = 'http://192.168.1.4:3000';\n\nlet pitchesText = '';\nif (pitches.length === 0) {\n  pitchesText = 'No hay canchas registradas en este complejo.';\n} else {\n  pitchesText = pitches.map((p, idx) => {\n    return `${idx + 1}. ID: ${p.id} | Nombre: \"${p.name}\" | Tipo: ${p.type || 'Fútbol'} | Superficie: ${p.surface || 'Sintética'} | Link Reservar: ${baseUrl}/cancha/${p.id}`;\n  }).join('\\n');\n}\n\nreturn [{\n  json: {\n    companyId: company.id,\n    companyName: company.name,\n    totalPitches: pitches.length,\n    pitchesListText: pitchesText,\n    pitchesData: pitches,\n    baseUrl: baseUrl\n  }\n}];"
      },
