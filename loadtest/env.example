# Copia este archivo como loadtest/.env.test y complétalo (.env.test NO se sube a git).

# A dónde apuntar: local (pnpm build && pnpm start) o producción.
BASE_URL=http://localhost:3000
# BASE_URL=https://www.cancheros.site   (con www: sin www redirige y las pruebas fallan)

# Supabase (los mismos de .env.local). La anon key es pública.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para DB_RACE=1 (inserciones directas a la base). Déjala vacía si no la necesitas.
SUPABASE_SERVICE_ROLE_KEY=

# CUENTAS DE PRUEBA (nunca las reales). Ejemplos con alias de Gmail:
#   dueño:   tucorreo+dueno@gmail.com   (aprobado como dueño, con un complejo de prueba)
#   jugador: tucorreo+jugador1@gmail.com, tucorreo+jugador2@gmail.com
OWNER_EMAIL=
OWNER_PASSWORD=
# Formato: correo:clave;correo:clave
PLAYER_ACCOUNTS=

# Cancha del COMPLEJO DE PRUEBA del dueño de prueba (uuid). Aquí se crean y borran reservas.
TEST_PITCH_ID=
# Opcional: cancha combinada/vinculada a la anterior (para probar choques entre canchas unidas).
TEST_LINKED_PITCH_ID=

# Prueba de doble reserva
ROUNDS=4
GUESTS=10
# TEST_DATE=2026-12-20   (por defecto: dentro de 21 días)
FIRST_HOUR=6
DB_RACE=0

# Pon 1 solo si de verdad quieres escribir/atacar producción.
I_UNDERSTAND_PRODUCTION=0

# Si activaste el CAPTCHA (TURNSTILE_SECRET_KEY) en el servidor, las pruebas de invitados necesitan
# un token válido. Para pruebas LOCALES usa las llaves de prueba de Cloudflare en .env.local:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# y aquí el token de prueba:
TURNSTILE_TEST_TOKEN=XXXX.DUMMY.TOKEN.XXXX
# En producción (llaves reales) los invitados del script serán rechazados con 403: es lo esperado.
